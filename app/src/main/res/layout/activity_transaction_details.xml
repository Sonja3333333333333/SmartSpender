<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Деталі операції"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvDetailAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDetailType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#4285F4"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDetailDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/tvDetailCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvDetailComment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:textColor="#333333" />

    <Button
        android:id="@+id/btnEditTransaction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Редагувати"
        android:textAllCaps="false"
        android:backgroundTint="#4285F4"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDeleteTransaction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Видалити"
        android:textAllCaps="false"
        android:backgroundTint="#E53935"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnBackToHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Назад"
        android:textAllCaps="false"
        android:backgroundTint="#F5F5F5"
        android:textColor="#333333" />

</LinearLayout>