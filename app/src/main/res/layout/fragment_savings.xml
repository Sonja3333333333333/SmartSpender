<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"> <TextView
    android:id="@+id/tv_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Накопичення"
    android:textSize="22sp"
    android:textColor="#333333"
    android:textStyle="bold"
    android:layout_alignParentStart="true"
    android:layout_marginTop="24dp"
    android:layout_marginStart="16dp"/>

    <View
        android:id="@+id/div_savings_header"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9D9D9"
        android:layout_below="@id/tv_title"
        android:layout_marginTop="16dp" />

    <ImageView
        android:id="@+id/iv_piggy_bank"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/savings_svgrepo_com"
        android:layout_below="@id/div_savings_header"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        app:tint="#5A5A5A" />

    <TextView
        android:id="@+id/tv_balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Баланс"
        android:textSize="16sp"
        android:textColor="#5A5A5A"
        android:layout_below="@id/iv_piggy_bank"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/tv_savings_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1200,00 UAH"
        android:textSize="32sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:layout_below="@id/tv_balance_label"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btn_spend_savings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Витратити гроші"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4285F4"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

</RelativeLayout>